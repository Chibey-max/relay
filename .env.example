# ============================================================
# RELAY — Environment Configuration
# Copy this file to .env.local and fill in your real keys.
# In DEMO mode (NEXT_PUBLIC_RELAY_MODE=demo) none of these are
# required — the app runs on a pre-seeded test signer.
# ============================================================

# ---- Mode -------------------------------------------------
# "demo" = pre-seeded signer, no login, safe to show anywhere
# "live" = real Magic login + real on-chain UserOps
NEXT_PUBLIC_RELAY_MODE=demo

# ---- Particle Network (Universal Accounts) ----------------
# dashboard.particle.network -> your project
NEXT_PUBLIC_PARTICLE_PROJECT_ID=
NEXT_PUBLIC_PARTICLE_CLIENT_KEY=
NEXT_PUBLIC_PARTICLE_APP_ID=

# ---- Magic (embedded wallet / login) ----------------------
# dashboard.magic.link -> your app
NEXT_PUBLIC_MAGIC_PUBLISHABLE_KEY=
# Server-side only (API Wallet / TEE flow):
MAGIC_SECRET_KEY=
MAGIC_OIDC_PROVIDER_ID=

# ---- ZeroDev (gas sponsorship + session keys) -------------
# dashboard.zerodev.app -> project -> Arbitrum Sepolia
NEXT_PUBLIC_ZERODEV_PROJECT_ID=
ZERODEV_BUNDLER_RPC=https://rpc.zerodev.app/api/v3/REPLACE_PROJECT_ID/chain/421614
ZERODEV_PAYMASTER_RPC=https://rpc.zerodev.app/api/v3/REPLACE_PROJECT_ID/chain/421614

# ---- Groq (natural-language intent parsing) ---------------
# console.groq.com
GROQ_API_KEY=

# ---- Chain ------------------------------------------------
NEXT_PUBLIC_CHAIN_ID=421614
NEXT_PUBLIC_EXPLORER=https://sepolia.arbiscan.io

# ---- Demo signer (DEMO mode only) -------------------------
# A funded Arbitrum Sepolia test key. NEVER a real key.
DEMO_PRIVATE_KEY=
DEMO_RECEIVER=0x000000000000000000000000000000000000dEaD
